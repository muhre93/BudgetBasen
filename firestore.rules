rules_version = '2';

// =====================================================================
//  BudgetBasen — Firestore Security Rules
//  Princip: ALT data ligger under /budgets/{budgetId}/..., og adgang
//  afgøres af budget-dokumentets "members"-map: { uid: 'admin'|'edit'|'read' }.
//  En bruger kan aldrig læse eller skrive i et budget, hun ikke er medlem af.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hjælpefunktioner ----------
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verifiedEmail() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }

    function budgetDoc(bid) { return get(/databases/$(database)/documents/budgets/$(bid)).data; }
    function roleIn(bid) { return budgetDoc(bid).members.get(request.auth.uid, ''); }
    function canRead(bid) { return signedIn() && roleIn(bid) in ['admin', 'edit', 'read']; }
    function canEdit(bid) { return signedIn() && roleIn(bid) in ['admin', 'edit']; }
    function isAdmin(bid) { return signedIn() && roleIn(bid) == 'admin'; }
    function isOwner(bid) { return signedIn() && budgetDoc(bid).ownerUid == request.auth.uid; }

    // App-ejeren (Ejer-admin). Skift e-mailen her, hvis ejeren skifter.
    function isAppOwner() { return verifiedEmail() && myEmail() == 'muhre93@gmail.com'; }

    // ---------- Brugerprofil: kun dig selv (ejeren kan se listen over brugere) ----------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAppOwner();
    }

    // ---------- App-indstillinger fra Ejer-admin ----------
    // Alle må læse (login-siden viser teksterne), kun ejeren må skrive.
    match /config/{id} {
      allow read: if true;
      allow write: if isAppOwner() && id == 'app';
    }

    // ---------- Budgetter ----------
    match /budgets/{bid} {
      // Læs: kun medlemmer (listen i appen hentes med memberUids array-contains uid)
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Opret: du bliver automatisk ejer og ENESTE medlem
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'admin'
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100;

      allow update: if adminUpdate() || editorUpdate() || acceptInvite(bid) || leaveBudget();

      // Kun ejeren kan slette hele budgettet
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      function myRole() { return resource.data.members.get(request.auth.uid, ''); }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      // Admin må ændre alt — men ejeren kan aldrig fjernes/degraderes, ejerskab kan ikke flyttes,
      // og members/memberUids skal altid stemme overens.
      function adminUpdate() {
        return signedIn() && myRole() == 'admin'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members.get(resource.data.ownerUid, '') == 'admin'
          && request.resource.data.members.values().hasOnly(['admin', 'edit', 'read'])
          && request.resource.data.members.keys().toSet() == request.resource.data.memberUids.toSet();
      }

      // Redaktør må kun opdatere saldo/indstillinger og tilføje værdier til lister
      function editorUpdate() {
        return signedIn() && myRole() == 'edit'
          && changed().hasOnly(['settings', 'lists', 'updatedAt']);
      }

      // En inviteret bruger må tilføje SIG SELV med præcis den rolle, invitationen angiver
      function acceptInvite(bid) {
        let invPath = /databases/$(database)/documents/invites/$(bid + '_' + myEmail());
        return verifiedEmail()
          && !(request.auth.uid in resource.data.memberUids)
          && exists(invPath)
          && changed().hasOnly(['members', 'memberUids', 'memberInfo'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == get(invPath).data.role
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]);
      }

      // Et medlem (ikke ejeren) må forlade budgettet
      function leaveBudget() {
        return signedIn()
          && request.auth.uid != resource.data.ownerUid
          && request.auth.uid in resource.data.memberUids
          && changed().hasOnly(['members', 'memberUids', 'memberInfo'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
      }

      // ----- Synlighed -----
      // Hver post/kvittering/dokument har visibleTo: ['all'] eller en liste af uid'er.
      // Man kan kun læse, rette og slette det man selv må se — det gælder OGSÅ admin og ejer,
      // så en gavekvittering eller et barns skjulte poster forbliver private.
      function canSee(d) { return 'all' in d.visibleTo || request.auth.uid in d.visibleTo; }
      function validVis(d) {
        return d.visibleTo is list && d.visibleTo.size() > 0 && d.visibleTo.size() <= 50
          && ('all' in d.visibleTo || request.auth.uid in d.visibleTo);   // man kan ikke skjule noget for sig selv
      }

      // ----- Budgetposter -----
      match /items/{itemId} {
        allow read: if canRead(bid) && canSee(resource.data);
        allow create: if canEdit(bid) && validItem(request.resource.data) && validVis(request.resource.data);
        allow update: if canEdit(bid) && canSee(resource.data) && validItem(request.resource.data) && validVis(request.resource.data);
        allow delete: if canEdit(bid) && canSee(resource.data);
      }
      function validItem(d) {
        return d.type in ['expense', 'income', 'transfer']
          && (d.type != 'transfer' || (d.toAccount is string && d.toAccount.size() > 0))
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.amount is number && d.amount >= 0 && d.amount < 100000000
          && d.freq is int && d.freq >= 1 && d.freq <= 120
          && d.payDay is int && d.payDay >= 1 && d.payDay <= 31;
      }

      // ----- Kvitteringer og dokumenter (selve filerne ligger i Cloudflare KV) -----
      match /receipts/{id} {
        allow read: if canRead(bid) && canSee(resource.data);
        allow create: if canEdit(bid) && validVis(request.resource.data);
        allow update: if canEdit(bid) && canSee(resource.data) && validVis(request.resource.data);
        allow delete: if canEdit(bid) && canSee(resource.data);
      }
      match /documents/{id} {
        allow read: if canRead(bid) && canSee(resource.data);
        allow create: if canEdit(bid) && validVis(request.resource.data);
        allow update: if canEdit(bid) && canSee(resource.data) && validVis(request.resource.data);
        allow delete: if canEdit(bid) && canSee(resource.data);
      }

      // ----- Bank (Enable Banking) -----
      // visibleTo: kontoens ejere (dem der har koblet den på) + evt. 'adults' = alle med rollen admin/redaktør.
      // Ingen andre uid'er og aldrig 'all' — så børn og andre med "Kun læse" kan aldrig se bankdata.
      function bankSee(d) { return request.auth.uid in d.visibleTo || ('adults' in d.visibleTo && roleIn(bid) in ['admin', 'edit']); }
      function validBankVis(d) {
        return d.owners is list && d.owners.size() > 0 && d.owners.size() <= 10
          && d.visibleTo is list && d.visibleTo.size() <= 11
          && d.visibleTo.toSet().hasAll(d.owners.toSet())
          && d.visibleTo.toSet().difference(d.owners.toSet()).hasOnly(['adults']);
      }
      function bankChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function onlyMine(field) { return request.resource.data[field].diff(resource.data.get(field, {})).affectedKeys().hasOnly([request.auth.uid]); }
      // Bevis for at man selv har koblet kontoen på: Worker'en giver kun beviset til den, der logger ind i banken.
      function joinProofOk(key) {
        let j = getAfter(/databases/$(database)/documents/budgets/$(bid)/bankJoins/$(key + '_' + request.auth.uid));
        return j != null && hashing.sha256(j.data.proof.toUtf8()).toHexString().lower() == resource.data.get('joinHash', '');
      }
      match /bankAccounts/{key} {
        // resource == null: så kan appen se, om kontoen allerede findes (fx koblet på af din partner)
        allow read: if canEdit(bid) && (resource == null || bankSee(resource.data));
        allow create: if canEdit(bid) && key.matches('^[0-9a-f]{24}$')
          && request.resource.data.owners == [request.auth.uid]
          && request.resource.data.joinHash is string && request.resource.data.joinHash.size() == 64
          && validBankVis(request.resource.data);
        allow update: if canEdit(bid) && (
          // En ejer må rette alt (men kun fjerne sig selv som ejer, og aldrig beviset)
          (request.auth.uid in resource.data.owners && validBankVis(request.resource.data)
            && request.resource.data.get('joinHash', '') == resource.data.get('joinHash', '')
            && (request.resource.data.owners.toSet() == resource.data.owners.toSet()
                || request.resource.data.owners.toSet() == resource.data.owners.toSet().difference([request.auth.uid].toSet())))
          // Din partner kobler den samme konto på → bliver medejer (kun med bevis, kun sig selv, samme synlighed + sig selv)
          || (!(request.auth.uid in resource.data.owners)
            && joinProofOk(key)
            && bankChanged().hasOnly(['owners', 'ownerNames', 'linked', 'visibleTo'])
            && request.resource.data.owners.toSet() == resource.data.owners.toSet().union([request.auth.uid].toSet())
            && request.resource.data.visibleTo.toSet() == resource.data.visibleTo.toSet().union([request.auth.uid].toSet())
            && onlyMine('ownerNames') && onlyMine('linked')
            && validBankVis(request.resource.data))
          // Andre voksne der kan se kontoen, må vælge hvilken budgetkonto den hører til
          || (bankSee(resource.data) && bankChanged().hasOnly(['budgetAccount']))
        );
        allow delete: if canEdit(bid) && resource.data.owners == [request.auth.uid];
      }
      // Beviset kan kun skrives (af en selv) — aldrig læses af nogen
      match /bankJoins/{id} {
        allow read: if false;
        allow create, update: if canEdit(bid) && id == request.resource.data.key + '_' + request.auth.uid
          && request.resource.data.proof is string && request.resource.data.proof.size() == 64;
        allow delete: if false;
      }
      function bankAcct(acct) { return /databases/$(database)/documents/budgets/$(bid)/bankAccounts/$(acct); }
      match /bankTx/{id} {
        allow read: if canEdit(bid) && (resource == null || bankSee(resource.data));
        // Kun kontoens ejere skriver posteringer, og synligheden skal altid være den samme som kontoens
        allow create, update: if canEdit(bid) && request.auth.uid in get(bankAcct(request.resource.data.acct)).data.owners
          && id == request.resource.data.acct + '_' + request.resource.data.ym
          && request.resource.data.visibleTo == getAfter(bankAcct(request.resource.data.acct)).data.visibleTo;
        allow delete: if canEdit(bid) && request.auth.uid in get(bankAcct(resource.data.acct)).data.owners;
      }

      // ----- Versioner til sammenligning -----
      match /snapshots/{id} {
        allow read: if canRead(bid);
        allow create, update: if canEdit(bid);
        allow delete: if isAdmin(bid);
      }

      // ----- Log: alle medlemmer kan skrive i eget navn, INGEN kan rette i den -----
      match /log/{id} {
        allow read: if canRead(bid);
        allow create: if canRead(bid) && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(bid); // kun når ejeren sletter hele budgettet
      }
    }

    // ---------- Invitationer ----------
    // Dokument-id = "{budgetId}_{email}" — så reglerne kan slå invitationen op direkte.
    match /invites/{inviteId} {
      allow read: if verifiedEmail() && resource.data.email == myEmail()
                  || signedIn() && isAdmin(resource.data.budgetId);
      allow create, update: if isAdmin(request.resource.data.budgetId)
        && inviteId == request.resource.data.budgetId + '_' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['admin', 'edit', 'read'];
      allow delete: if verifiedEmail() && resource.data.email == myEmail()
                    || signedIn() && isAdmin(resource.data.budgetId);
    }

    // ---------- Read-only links (f.eks. til banken) ----------
    // Alle med det lange, tilfældige link kan LÆSE ét dokument — men ingen kan liste/søge i dem.
    match /shares/{token} {
      allow get: if resource.data.expiresAt == null || request.time < resource.data.expiresAt;
      allow list: if false;
      allow create: if isAdmin(request.resource.data.budgetId)
        && request.resource.data.createdBy == request.auth.uid
        && token.size() >= 20;
      allow delete: if isAdmin(resource.data.budgetId);
      allow update: if false;
    }

    // Alt andet: nej.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
